<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Overwritten by the release workflow (-p:Version=...). The committed value
         is a local-development placeholder surfaced by the /api/version endpoint. -->
    <Version>0.0.0-dev</Version>
    <!-- Keep the informational version exactly equal to Version so the endpoint
         returns a clean value instead of one with a '+<commit-sha>' suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SQLitePCLRaw.core" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShiaiManager.Api.Tests" />
  </ItemGroup>

</Project>
